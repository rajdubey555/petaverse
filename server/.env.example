# ─────────────────────────────────────────────
# PetVerse Server — Environment Variables
# ─────────────────────────────────────────────

# ── Server ──
NODE_ENV=development
PORT=5000

# ── MongoDB ──
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/petaverse?retryWrites=true&w=majority
# For local development:
# MONGODB_URI=mongodb://localhost:27017/petaverse

# ── JWT ──
ACCESS_TOKEN_SECRET=your_access_token_secret_here_change_in_production_min_64_chars
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here_change_in_production_min_64_chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
REFRESH_TOKEN_EXPIRY_MS=604800000

# ── Google OAuth ──
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# ── Cloudinary ──
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Client ──
CLIENT_URL=http://localhost:5173